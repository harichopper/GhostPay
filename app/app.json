{
  "expo": {
    "name": "GhostPay",
    "slug": "ghostpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/branding/ghostpay-logo.png",
    "splash": {
      "image": "./assets/branding/ghostpay-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "ghostpay",
    "android": {
      "package": "com.ghostpay.wallet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/ghostpay-logo.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/ghostpay-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
