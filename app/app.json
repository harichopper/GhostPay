{
  "expo": {
    "name": "GhostPay",
    "slug": "ghostpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "ghostpay",
    "android": {
      "package": "com.ghostpay.wallet",
      "adaptiveIcon": {
        "backgroundColor": "#05070B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
