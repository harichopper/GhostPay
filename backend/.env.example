PORT=4000
CORS_ORIGIN=*
MONGODB_URI=
MONGODB_DB_NAME=ghostpay
OTP_EXPIRY_MINUTES=5
REVEAL_OTP_IN_RESPONSE=true
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
OTP_MESSAGE_TEMPLATE=Your GhostPay verification code is {{OTP}}. It expires in {{MINUTES}} minutes.
ALGORAND_NETWORK=testnet
ALGORAND_ALGOD_SERVER=
ALGORAND_ALGOD_PORT=
ALGORAND_ALGOD_TOKEN=
ALGORAND_EXPLORER_TX_BASE_URL=
ALGORAND_SENDER_MNEMONIC=
ALLOW_DEMO_MODE=true
MAX_ALGO_PER_TX=1000
CONFIRMATION_ROUNDS=6
GHOSTPAY_CONTRACT_APP_ID=0
ENFORCE_CONTRACT=false
REQUIRE_IDENTITY_FOR_SEND=true
# x402 payment protocol
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# X402_PAY_TO=  # Optional: override payTo address (defaults to ALGORAND_SENDER_MNEMONIC derived address)
# X402_NETWORK= # Optional: override CAIP-2 network (defaults to algorand testnet/mainnet per ALGORAND_NETWORK)
# X402_ASSET=   # Optional: override USDC ASA ID (testnet: 10458941, mainnet: 31566704)
# X402_PRICE_CENTS=10  # Optional: price in USD cents for security analysis (default: 10 = $0.10)
# x402 account-mapping API key (service-to-service auth)
# Leave empty in development for open access.
# Set to a strong secret in production to protect account resolution endpoints.
ACCOUNTS_API_KEY=
